.scribe-result-panel
  padding 16px
  min-width 300px
  max-width 800px
  width fit-content
  border-radius 8px
  box-shadow 0 4px 20px rgba(0,0,0,0.15)
  position relative
  @media (max-width: 768px)
    min-width unset
    max-width unset
    width 100%
    border-radius 0
    box-shadow none
    box-sizing border-box

.scribe-result-header
  display flex
  align-items center
  justify-content space-between
  margin-bottom 8px

.scribe-result-text
  max-height min(500px, 70vh)
  min-height 48px
  overflow-y auto
  padding 12px
  border-radius 4px
  font-family inherit
  font-size 13px
  line-height 1.5
  white-space normal
  margin-bottom 12px
  transition max-height 200ms ease-out

.scribe-result-actions
  display flex
  justify-content flex-end
  align-items center
  gap 8px

.scribe-resize-handle
  position absolute
  bottom 0
  right 0
  width 16px
  height 16px
  cursor nwse-resize
  opacity 0.3
  transition opacity 150ms ease
  &:hover
    opacity 0.6
  &::after
    content ''
    position absolute
    bottom 3px
    right 3px
    width 8px
    height 8px
    border-right 2px solid currentColor
    border-bottom 2px solid currentColor
  &::before
    content ''
    position absolute
    bottom 3px
    right 3px
    width 4px
    height 4px
    border-right 2px solid currentColor
    border-bottom 2px solid currentColor

// -- MarkdownPreview: code blocks & inline code --
// Nested under & so CSS modules hashes the parent class correctly
.scribe-md-preview
  & pre
    background #282c34
    color #d4d4d4
    padding 12px
    border-radius 4px
    overflow-x auto
    margin 8px 0
    font-family "Courier New", Consolas, Monaco, monospace
    font-size 0.85em
    line-height 1.5
    white-space pre
  & pre > code
    background none
    padding 0
    border-radius 0
    font-size inherit
    font-family inherit
    color inherit
    white-space inherit
  & :not(pre) > code
    background rgba(128, 128, 128, 0.15)
    padding 2px 4px
    border-radius 3px
    font-size 0.9em
    font-family "Courier New", Consolas, Monaco, monospace

.scribe-loading-panel
  padding 32px 48px
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 16px
  min-width 250px
  border-radius 8px
  box-shadow 0 4px 20px rgba(0,0,0,0.15)
  @media (max-width: 768px)
    min-width unset
    width 100%
    border-radius 0
    box-shadow none
    box-sizing border-box

.scribe-loading-message
  text-align center
  font-style italic


// -- Anchored inline menu: the arrow pointing back at the selection --
//
// A BORDER TRIANGLE, not a rotated square. The square version was invisible: a
// white lozenge on a white page, separated from it by a 6% shadow, with its
// outer edge lost in the menu's own soft shadow. A triangle can be outlined with
// `drop-shadow`, which follows the alpha SHAPE instead of the box — so the arrow
// gets a real edge on any background, and no seam where it meets the card.
//
// Only the triangle is ours. Its position along the menu's edge is written by
// popper.js (inline `left`), because it has to follow the anchor when the menu is
// shifted sideways to stay in the window — an arrow pinned to a corner would end
// up pointing at nothing.
//
// The fill colour comes from a CSS variable set on the wrapper: this file cannot
// read the MUI theme, and the arrow MUST match the menu's paper in both themes.
.scribe-anchor-arrow
  position absolute
  width 0
  height 0
  pointer-events none
  border-left 9px solid transparent
  border-right 9px solid transparent

// The wrapper carries the resolved placement, so the arrow sits on the edge
// FACING the selection whichever way popper decided to flip.
[data-scribe-placement^='bottom'] .scribe-anchor-arrow
  top -9px
  border-bottom 9px solid var(--scribe-arrow-bg, #fff)
  filter drop-shadow(0 -2px 1.5px rgba(0,0,0,0.22))

[data-scribe-placement^='top'] .scribe-anchor-arrow
  bottom -9px
  border-top 9px solid var(--scribe-arrow-bg, #fff)
  filter drop-shadow(0 2px 1.5px rgba(0,0,0,0.22))
